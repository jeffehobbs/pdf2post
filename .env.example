# Copy to .env and fill in. .env is gitignored.

# WordPress site + REST auth (Application Password)
WP_URL=https://electricant.space
WP_USER=your-wp-login-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Default author credited on posts (username/slug or numeric user id).
# Overridable per run with --author. The WP_USER account must have permission
# to edit others' posts (Author/Editor/Admin) to attribute to a different user.
WP_AUTHOR=

# Default post status (publish | draft | pending | private). --status overrides.
WP_STATUS=publish

# Optional: force every post under this category name (created if missing).
WP_CATEGORY=

# Set to 1/true to have the LLM assign each post to the best-fitting existing
# category on the site (same as passing --auto-category).
WP_AUTO_CATEGORY=

# Local LLM used to decide post boundaries + titles.
OLLAMA_MODEL=gemma4:latest

# Ollama context window, in tokens. Must be big enough to hold the whole
# document — too small and the model silently sees only the start of the PDF
# and under-segments it.
OLLAMA_NUM_CTX=32768
